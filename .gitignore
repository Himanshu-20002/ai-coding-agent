# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment variables & local secrets
.env
.env.local

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Output generated files (preserve directory structure via .gitkeep)
output/plans/*
!output/plans/.gitkeep
output/reports/*
!output/reports/.gitkeep
output/logs/*
!output/logs/.gitkeep

# Target repository workspace contents (preserve workspace folder)
workspace/*
!workspace/.gitkeep
